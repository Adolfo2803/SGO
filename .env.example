# ============================================================
# SGO — Variables de entorno para producción
# Copie este archivo a .env y reemplace los valores ficticios.
# .env NO se versiona (está en .gitignore).
# ============================================================

# --- Base de datos ---
POSTGRES_DB=sgo
POSTGRES_USER=sgo
POSTGRES_PASSWORD=cambiar_por_contraseña_segura

# --- Usuario administrador inicial ---
# Se usa solo si la tabla usuario está vacía (primer arranque).
SGO_ADMIN_PASSWORD=cambiar_por_contraseña_segura

# --- Correo SMTP ---
MAIL_HOST=smtp.hospital.local
MAIL_PORT=587
MAIL_USERNAME=sgo@hospital.local
MAIL_PASSWORD=cambiar_por_contraseña_smtp
SGO_CORREO_REMITENTE=sgo@hospital.local

# --- Nombre de la dirección (aparece en oficios de salida) ---
SGO_DIRECCION_NOMBRE=Dirección del Hospital General
